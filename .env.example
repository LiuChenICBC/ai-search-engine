# AI Search Engine 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 管理后台密码（必须设置）
WWW_SEARCH_ADMIN_PASSWORD=your-strong-password-here

# Session 签名密钥（必须设置，32 字符 hex）
# 生成方式: python3 -c 'import secrets; print(secrets.token_hex(32))'
WWW_SEARCH_SECRET_KEY=your-secret-key-here

# LLM API Key（可选，优先于 config.yaml 中的配置）
WWW_SEARCH_LLM_API_KEY=your-llm-api-key-here

# 开发模式：启用热重载（默认 false）
WWW_SEARCH_RELOAD=false